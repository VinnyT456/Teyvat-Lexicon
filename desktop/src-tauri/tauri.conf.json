{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Teyvat Lexicon",
  "version": "0.1.0",
  "identifier": "com.teyvatlexicon.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "Teyvat Lexicon — Translation Desk",
      "width": 1120,
      "height": 900,
      "minWidth": 760,
      "minHeight": 680
    }],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:8000 ws://localhost:1420 ws://127.0.0.1:1420; style-src 'self' 'unsafe-inline';"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"],
    "resources": ["licenses/*"]
  }
}
